{
  "name": "deeplarp",
  "version": "0.1.0",
  "description": "Scores how much a GitHub profile or repo is larping: what it claims against what the code shows.",
  "type": "module",
  "bin": {
    "deeplarp": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "keywords": [
    "github",
    "larp",
    "roast",
    "profile",
    "audit",
    "cli"
  ],
  "author": "nitrimandylis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrimandylis/deeplarp.git"
  },
  "homepage": "https://github.com/nitrimandylis/deeplarp#readme",
  "bugs": "https://github.com/nitrimandylis/deeplarp/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build src/cli.ts --outfile dist/cli.js --target node --format esm --external @resvg/resvg-js",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "tsc --noEmit && bun test",
    "calibrate": "bun src/calibrate.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.35.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
